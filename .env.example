# Copy to .env.local and fill in. Everything without NEXT_PUBLIC_ stays on the
# server; never prefix a secret with NEXT_PUBLIC_.

# ── Dashboard login ─────────────────────────────────────────────────────────
# Signs the gt_session cookie, and derives the key that encrypts stored
# Google/Meta tokens. Rotating it signs everyone out AND means reconnecting
# every integration.
AUTH_SECRET=
DASHBOARD_PASSWORD=
SPLEXZ_PASS=

# Public URL of the deployment (no trailing slash). Pins OAuth redirect URIs;
# leave empty on localhost to use the request's own origin.
APP_URL=
NEXT_PUBLIC_APP_URL=

# ── Supabase (project figvcskjslkvomoxubuq — NOT Atrium's) ──────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Social Scheduler (/tools/social) ────────────────────────────────────────
# The Meta app used for publishing (separate from the ads app below).
SOCIAL_META_APP_ID=
SOCIAL_META_APP_SECRET=
# Optional: a Facebook Login for Business configuration id. When set, the
# login dialog uses config_id; otherwise it asks for the scopes directly.
SOCIAL_META_LOGIN_CONFIG_ID=
# Shared with Supabase Vault (secret name: social_tick_secret). Supabase sends
# it as a Bearer token when it calls /api/tools/social/tick. Any long random
# string, e.g. `openssl rand -hex 32`.
SOCIAL_TICK_SECRET=

# ── Ads tracker (/ads) ──────────────────────────────────────────────────────
META_ACCESS_TOKEN=
META_APP_ID=
META_APP_SECRET=
META_AD_ACCOUNT_ID=

# ── Google Calendar (/cal) ──────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional sync window, in days. Leave commented for the defaults; a blank
# value would be read as 0.
# GOOGLE_SYNC_PAST_DAYS=120
# GOOGLE_SYNC_FUTURE_DAYS=400
# Bearer secret for /api/google/cron (Vercel Cron sends it automatically).
CRON_SECRET=

# ── Integrations ────────────────────────────────────────────────────────────
PERSONAL_API_SECRET=
# Comma-separated origins allowed to call /api/atrium (booking widget).
ATRIUM_ALLOWED_ORIGINS=
FREELLMAPI_URL=
FREELLMAPI_ADMIN_EMAIL=
FREELLMAPI_ADMIN_PASSWORD=
